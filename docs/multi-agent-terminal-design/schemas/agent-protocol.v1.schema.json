{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-terminal.local/schemas/agent-protocol.v1.schema.json",
  "title": "Open Agent Protocol v1 Frame",
  "oneOf": [
    { "$ref": "#/$defs/initializeRequest" },
    { "$ref": "#/$defs/initializedNotification" },
    { "$ref": "#/$defs/runStartRequest" },
    { "$ref": "#/$defs/runCancelRequest" },
    { "$ref": "#/$defs/runCompleteRequest" },
    { "$ref": "#/$defs/streamDeltaNotification" },
    { "$ref": "#/$defs/contextQueryRequest" },
    { "$ref": "#/$defs/toolRequest" },
    { "$ref": "#/$defs/specialistRequest" },
    { "$ref": "#/$defs/heartbeatNotification" },
    { "$ref": "#/$defs/shutdownRequest" },
    { "$ref": "#/$defs/exitNotification" },
    { "$ref": "#/$defs/successResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(core|agent):[A-Za-z0-9._:-]+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "jsonRpcRequestBase": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/requestId" },
        "method": { "type": "string" },
        "params": { "type": "object" }
      }
    },
    "jsonRpcNotificationBase": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "type": "string" },
        "params": { "type": "object" }
      },
      "not": { "required": ["id"] }
    },
    "initializeRequest": {
      "allOf": [
        { "$ref": "#/$defs/jsonRpcRequestBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jsonrpc": { "const": "2.0" },
            "id": { "$ref": "#/$defs/requestId" },
            "method": { "const": "initialize" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "protocolVersions",
                "client",
                "transport",
                "features",
                "launchBinding"
              ],
              "properties": {
                "protocolVersions": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
                },
                "client": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "version"],
                  "properties": {
                    "name": { "$ref": "#/$defs/identifier" },
                    "version": { "$ref": "#/$defs/identifier" }
                  }
                },
                "transport": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "maxFrameBytes"],
                  "properties": {
                    "type": { "const": "stdio-ndjson" },
                    "maxFrameBytes": {
                      "type": "integer",
                      "minimum": 1024,
                      "maximum": 67108864
                    }
                  }
                },
                "features": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/identifier" }
                },
                "launchBinding": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "connectionId",
                    "manifestDigest",
                    "executableDigest",
                    "trustTier"
                  ],
                  "properties": {
                    "connectionId": { "$ref": "#/$defs/identifier" },
                    "manifestDigest": { "$ref": "#/$defs/sha256" },
                    "executableDigest": { "$ref": "#/$defs/sha256" },
                    "trustTier": {
                      "enum": [
                        "core_adapter",
                        "brokered_process",
                        "isolated_worker",
                        "full_access_legacy"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "initializedNotification": {
      "allOf": [
        { "$ref": "#/$defs/jsonRpcNotificationBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jsonrpc": { "const": "2.0" },
            "method": { "const": "initialized" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["connectionId", "effectiveCapabilitiesDigest"],
              "properties": {
                "connectionId": { "$ref": "#/$defs/identifier" },
                "effectiveCapabilitiesDigest": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        }
      ]
    },
    "contextPackageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "contentDigest", "manifestRef"],
      "properties": {
        "packageId": { "$ref": "#/$defs/identifier" },
        "contentDigest": { "$ref": "#/$defs/sha256" },
        "manifestRef": { "$ref": "#/$defs/identifier" },
        "inlineSummary": { "type": "string", "maxLength": 65536 }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contextQuery", "toolRequest", "writeFiles"],
      "properties": {
        "contextQuery": { "type": "boolean" },
        "toolRequest": { "type": "boolean" },
        "writeFiles": { "type": "boolean" }
      }
    },
    "runStartRequest": {
      "allOf": [
        { "$ref": "#/$defs/jsonRpcRequestBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jsonrpc": { "const": "2.0" },
            "id": { "$ref": "#/$defs/requestId" },
            "method": { "const": "agent.run.start" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runId",
                "idempotencyKey",
                "taskId",
                "role",
                "objective",
                "contextPackage",
                "permissions",
                "responseSchema",
                "limits"
              ],
              "properties": {
                "runId": { "$ref": "#/$defs/identifier" },
                "idempotencyKey": { "$ref": "#/$defs/identifier" },
                "taskId": { "$ref": "#/$defs/identifier" },
                "role": { "$ref": "#/$defs/identifier" },
                "objective": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                },
                "contextPackage": { "$ref": "#/$defs/contextPackageRef" },
                "permissions": { "$ref": "#/$defs/permissions" },
                "responseSchema": { "const": "agent-message.v1" },
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["deadline", "maxOutputTokens", "maxToolRequests"],
                  "properties": {
                    "deadline": { "$ref": "#/$defs/timestamp" },
                    "maxOutputTokens": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000000
                    },
                    "maxToolRequests": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10000
                    }
                  }
                },
                "supersedesRunId": { "$ref": "#/$defs/identifier" }
              }
            }
          }
        }
      ]
    },
    "runCancelRequest": {
      "allOf": [
        { "$ref": "#/$defs/jsonRpcRequestBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jsonrpc": { "const": "2.0" },
            "id": { "$ref": "#/$defs/requestId" },
            "method": { "const": "agent.run.cancel" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runId", "reason", "deadlineMs"],
              "properties": {
                "runId": { "$ref": "#/$defs/identifier" },
                "reason": { "$ref": "#/$defs/identifier" },
                "deadlineMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300000
                }
              }
            }
          }
        }
      ]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "sourceId",
        "revision",
        "contentDigest"
      ],
      "properties": {
        "sourceType": {
          "enum": ["repository", "artifact", "event", "tool", "external"]
        },
        "sourceId": { "$ref": "#/$defs/identifier" },
        "revision": { "$ref": "#/$defs/identifier" },
        "contentDigest": { "$ref": "#/$defs/sha256" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string", "maxLength": 1024 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "text", "evidenceRefs", "confidence"],
      "properties": {
        "claimId": { "$ref": "#/$defs/identifier" },
        "text": { "type": "string", "minLength": 1, "maxLength": 131072 },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "agentMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "type", "content", "claims"],
      "properties": {
        "messageId": { "$ref": "#/$defs/identifier" },
        "type": {
          "enum": [
            "analysis",
            "proposal",
            "critique",
            "question",
            "answer",
            "support",
            "objection",
            "evidence_request",
            "evidence",
            "decision_recommendation",
            "plan",
            "implementation_report",
            "review",
            "status"
          ]
        },
        "replyTo": { "$ref": "#/$defs/identifier" },
        "threadId": { "$ref": "#/$defs/identifier" },
        "content": { "type": "string", "maxLength": 1048576 },
        "claims": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/claim" }
        }
      }
    },
    "runCompleteRequest": {
      "allOf": [
        { "$ref": "#/$defs/jsonRpcRequestBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jsonrpc": { "const": "2.0" },
            "id": { "$ref": "#/$defs/requestId" },
            "method": { "const": "agent.run.complete" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runId", "status", "message"],
              "properties": {
                "runId": { "$ref": "#/$defs/identifier" },
                "status": {
                  "enum": ["succeeded", "failed", "cancelled_cleanly"]
                },
                "message": { "$ref": "#/$defs/agentMessage" },
                "usage": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "inputTokens": { "type": "integer", "minimum": 0 },
                    "outputTokens": { "type": "integer", "minimum": 0 },
                    "providerReportedCost": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "streamDeltaNotification": {
      "allOf": [
        { "$ref": "#/$defs/jsonRpcNotificationBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jsonrpc": { "const": "2.0" },
            "method": { "const": "agent.stream.delta" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runId", "sequence", "channel", "delta"],
              "properties": {
                "runId": { "$ref": "#/$defs/identifier" },
                "sequence": { "type": "integer", "minimum": 1 },
                "channel": { "enum": ["content", "status"] },
                "delta": { "type": "string", "maxLength": 1048576 }
              }
            }
          }
        }
      ]
    },
    "contextQueryRequest": {
      "allOf": [
        { "$ref": "#/$defs/jsonRpcRequestBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jsonrpc": { "const": "2.0" },
            "id": { "$ref": "#/$defs/requestId" },
            "method": { "const": "context.query" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runId",
                "queryId",
                "query",
                "scopes",
                "maxItems",
                "maxTokens"
              ],
              "properties": {
                "runId": { "$ref": "#/$defs/identifier" },
                "queryId": { "$ref": "#/$defs/identifier" },
                "query": { "type": "string", "minLength": 1, "maxLength": 65536 },
                "scopes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "task",
                      "discussion",
                      "project-memory",
                      "decisions",
                      "repository",
                      "artifacts",
                      "tool-results"
                    ]
                  }
                },
                "maxItems": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "maxTokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              }
            }
          }
        }
      ]
    },
    "toolRequest": {
      "allOf": [
        { "$ref": "#/$defs/jsonRpcRequestBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jsonrpc": { "const": "2.0" },
            "id": { "$ref": "#/$defs/requestId" },
            "method": { "const": "tool.request" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runId",
                "requestId",
                "tool",
                "arguments",
                "reason"
              ],
              "properties": {
                "runId": { "$ref": "#/$defs/identifier" },
                "requestId": { "$ref": "#/$defs/identifier" },
                "planStepId": { "$ref": "#/$defs/identifier" },
                "executorFencingToken": {
                  "type": ["integer", "null"],
                  "minimum": 1
                },
                "tool": { "$ref": "#/$defs/identifier" },
                "arguments": {
                  "type": "object",
                  "maxProperties": 256
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                }
              }
            }
          }
        }
      ]
    },
    "specialistRequest": {
      "allOf": [
        { "$ref": "#/$defs/jsonRpcRequestBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jsonrpc": { "const": "2.0" },
            "id": { "$ref": "#/$defs/requestId" },
            "method": { "const": "specialist.request" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runId", "capability", "reason", "requiredContext"],
              "properties": {
                "runId": { "$ref": "#/$defs/identifier" },
                "capability": { "$ref": "#/$defs/identifier" },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                },
                "requiredContext": {
                  "type": "array",
                  "maxItems": 128,
                  "items": { "$ref": "#/$defs/identifier" }
                }
              }
            }
          }
        }
      ]
    },
    "heartbeatNotification": {
      "allOf": [
        { "$ref": "#/$defs/jsonRpcNotificationBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jsonrpc": { "const": "2.0" },
            "method": { "const": "agent.heartbeat" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": ["connectionId", "sequence"],
              "properties": {
                "connectionId": { "$ref": "#/$defs/identifier" },
                "sequence": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      ]
    },
    "shutdownRequest": {
      "allOf": [
        { "$ref": "#/$defs/jsonRpcRequestBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jsonrpc": { "const": "2.0" },
            "id": { "$ref": "#/$defs/requestId" },
            "method": { "const": "shutdown" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        }
      ]
    },
    "exitNotification": {
      "allOf": [
        { "$ref": "#/$defs/jsonRpcNotificationBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jsonrpc": { "const": "2.0" },
            "method": { "const": "exit" },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            }
          }
        }
      ]
    },
    "successResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/requestId" },
        "result": {}
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/requestId" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer" },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "data": {
              "type": "object",
              "maxProperties": 256
            }
          }
        }
      }
    }
  }
}
