{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-terminal.local/schemas/benchmark-case-result.v1.schema.json",
  "title": "Benchmark Case Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "logicalCaseId",
    "caseVersion",
    "scores",
    "verifierDecision",
    "regressions",
    "evidenceArtifactIds",
    "resultDigest",
    "createdAt"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "logicalCaseId": {
      "type": "string",
      "minLength": 1
    },
    "caseVersion": {
      "type": "integer",
      "minimum": 1
    },
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      }
    },
    "verifierDecision": {
      "enum": [
        "pass",
        "fail",
        "indeterminate"
      ]
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceArtifactIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resultDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
