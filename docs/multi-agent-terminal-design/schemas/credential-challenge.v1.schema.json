{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-terminal.local/schemas/credential-challenge.v1.schema.json",
  "title": "Credential Challenge v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "challengeId",
    "actorBindingId",
    "purpose",
    "operationDigest",
    "nonce",
    "challengeDigest",
    "issuedAt",
    "expiresAt",
    "status"
  ],
  "properties": {
    "challengeId": {
      "type": "string",
      "minLength": 1
    },
    "actorBindingId": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "enum": [
        "plan.approval",
        "deliverable.approval",
        "workspace.approval",
        "final_commit.approval",
        "policy_exception.approval"
      ]
    },
    "operationDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 24
    },
    "challengeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "pending",
        "consumed",
        "expired",
        "revoked"
      ]
    }
  }
}
