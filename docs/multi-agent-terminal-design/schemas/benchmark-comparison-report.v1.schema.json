{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-terminal.local/schemas/benchmark-comparison-report.v1.schema.json",
  "title": "Controlled Benchmark Comparison Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparisonId",
    "baselineRunId",
    "candidateRunId",
    "controlledConfigurationDigest",
    "declaredTreatmentDimensions",
    "controlEqualityReceiptDigest",
    "perCaseRegressions",
    "metricDeltas",
    "result",
    "comparisonDigest",
    "createdAt"
  ],
  "properties": {
    "comparisonId": {
      "type": "string",
      "minLength": 1
    },
    "baselineRunId": {
      "type": "string",
      "minLength": 1
    },
    "candidateRunId": {
      "type": "string",
      "minLength": 1
    },
    "controlledConfigurationDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "declaredTreatmentDimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "retrievalPipeline",
          "contextCompiler",
          "memoryPolicy"
        ]
      }
    },
    "controlEqualityReceiptDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "perCaseRegressions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metricDeltas": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "result": {
      "enum": [
        "improved",
        "equivalent",
        "regressed",
        "invalid"
      ]
    },
    "comparisonDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
