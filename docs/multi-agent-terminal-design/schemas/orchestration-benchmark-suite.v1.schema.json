{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-terminal.local/schemas/orchestration-benchmark-suite.v1.schema.json",
  "title": "Orchestration Product-Proof Benchmark Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteId",
    "suiteVersion",
    "purpose",
    "equalBudgetPolicy",
    "arms",
    "cases",
    "requiredMetrics",
    "replicationCount",
    "randomizationPolicy",
    "evaluatorConfigurationDigest",
    "acceptancePolicy",
    "createdAt",
    "suiteDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "suiteId": {
      "type": "string",
      "minLength": 1
    },
    "suiteVersion": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "const": "orchestration_product_proof"
    },
    "equalBudgetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparisonUnit",
        "controlledDimensions",
        "varianceTolerancePercent",
        "overflowPolicy"
      ],
      "properties": {
        "comparisonUnit": {
          "const": "case_repeat"
        },
        "controlledDimensions": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "input_tokens",
              "output_tokens",
              "tool_calls",
              "wall_time_ms",
              "cost_microunits",
              "repository_revision",
              "acceptance_rules",
              "tool_policy",
              "evaluator_configuration"
            ]
          }
        },
        "varianceTolerancePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "overflowPolicy": {
          "const": "mark_invalid_not_rebalance"
        }
      }
    },
    "arms": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "single_direct",
          "single_with_retrieval_and_verification",
          "same_model_multi_sample",
          "quick_profile",
          "standard_cross_review",
          "high_assurance",
          "heterogeneous_models"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "single_direct"
          }
        },
        {
          "contains": {
            "const": "single_with_retrieval_and_verification"
          }
        },
        {
          "contains": {
            "const": "same_model_multi_sample"
          }
        },
        {
          "contains": {
            "const": "quick_profile"
          }
        },
        {
          "contains": {
            "const": "standard_cross_review"
          }
        },
        {
          "contains": {
            "const": "high_assurance"
          }
        },
        {
          "contains": {
            "const": "heterogeneous_models"
          }
        }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "category",
          "repositoryRevision",
          "fixtureArtifactRef",
          "objectiveArtifactRef",
          "acceptanceRulesDigest",
          "budget"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "bug_fix",
              "feature_change",
              "refactor",
              "security_review",
              "research",
              "migration"
            ]
          },
          "repositoryRevision": {
            "type": "string",
            "minLength": 7
          },
          "fixtureArtifactRef": {
            "type": "string",
            "minLength": 1
          },
          "objectiveArtifactRef": {
            "type": "string",
            "minLength": 1
          },
          "acceptanceRulesDigest": {
            "$ref": "#/$defs/digest"
          },
          "budget": {
            "$ref": "#/$defs/budget"
          }
        }
      }
    },
    "requiredMetrics": {
      "type": "array",
      "minItems": 14,
      "uniqueItems": true,
      "items": {
        "enum": [
          "accepted_outcome",
          "defect_escape_count",
          "first_pass_test_success",
          "unsupported_claim_count",
          "requirement_omission_count",
          "human_correction_minutes",
          "time_to_accepted_ms",
          "input_tokens",
          "output_tokens",
          "tool_calls",
          "cost_microunits",
          "approval_interruptions",
          "task_abandoned",
          "reviewer_unique_findings"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "accepted_outcome"
          }
        },
        {
          "contains": {
            "const": "defect_escape_count"
          }
        },
        {
          "contains": {
            "const": "first_pass_test_success"
          }
        },
        {
          "contains": {
            "const": "unsupported_claim_count"
          }
        },
        {
          "contains": {
            "const": "requirement_omission_count"
          }
        },
        {
          "contains": {
            "const": "human_correction_minutes"
          }
        },
        {
          "contains": {
            "const": "time_to_accepted_ms"
          }
        },
        {
          "contains": {
            "const": "input_tokens"
          }
        },
        {
          "contains": {
            "const": "output_tokens"
          }
        },
        {
          "contains": {
            "const": "tool_calls"
          }
        },
        {
          "contains": {
            "const": "cost_microunits"
          }
        },
        {
          "contains": {
            "const": "approval_interruptions"
          }
        },
        {
          "contains": {
            "const": "task_abandoned"
          }
        },
        {
          "contains": {
            "const": "reviewer_unique_findings"
          }
        }
      ]
    },
    "replicationCount": {
      "type": "integer",
      "minimum": 3
    },
    "randomizationPolicy": {
      "enum": [
        "blocked_randomization_by_case_and_repeat",
        "fixed_deterministic_order_for_debug_only"
      ]
    },
    "evaluatorConfigurationDigest": {
      "$ref": "#/$defs/digest"
    },
    "acceptancePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryMetric",
        "nonInferiorityMetrics",
        "minimumAcceptedCasesPerCategory",
        "claimRule"
      ],
      "properties": {
        "primaryMetric": {
          "const": "accepted_outcome"
        },
        "nonInferiorityMetrics": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "accepted_outcome",
              "defect_escape_count",
              "first_pass_test_success",
              "unsupported_claim_count",
              "requirement_omission_count",
              "human_correction_minutes",
              "time_to_accepted_ms",
              "input_tokens",
              "output_tokens",
              "tool_calls",
              "cost_microunits",
              "approval_interruptions",
              "task_abandoned",
              "reviewer_unique_findings"
            ]
          }
        },
        "minimumAcceptedCasesPerCategory": {
          "type": "integer",
          "minimum": 3
        },
        "claimRule": {
          "const": "no_quality_claim_without_predeclared_thresholds_and_paired_uncertainty"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "suiteDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "toolCalls",
        "wallTimeMs",
        "costMicrounits",
        "currency"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 0
        },
        "wallTimeMs": {
          "type": "integer",
          "minimum": 1
        },
        "costMicrounits": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
