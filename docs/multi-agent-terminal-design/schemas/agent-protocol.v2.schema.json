{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-terminal.local/schemas/agent-protocol.v2.schema.json",
  "title": "MAT Agent Control Protocol v2 frames",
  "description": "Frame schemas. For responses, the receiver validates against the response definition selected from the durable pending request method; it never trusts a peer-supplied method discriminator.",
  "oneOf": [
    {
      "$ref": "#/$defs/initializeRequest"
    },
    {
      "$ref": "#/$defs/initializedNotification"
    },
    {
      "$ref": "#/$defs/runStartRequest"
    },
    {
      "$ref": "#/$defs/runCancelRequest"
    },
    {
      "$ref": "#/$defs/runCompleteRequest"
    },
    {
      "$ref": "#/$defs/streamDeltaNotification"
    },
    {
      "$ref": "#/$defs/contextQueryRequest"
    },
    {
      "$ref": "#/$defs/toolRequest"
    },
    {
      "$ref": "#/$defs/specialistRequest"
    },
    {
      "$ref": "#/$defs/heartbeatNotification"
    },
    {
      "$ref": "#/$defs/shutdownRequest"
    },
    {
      "$ref": "#/$defs/exitNotification"
    },
    {
      "$ref": "#/$defs/initializeResponse"
    },
    {
      "$ref": "#/$defs/runStartResponse"
    },
    {
      "$ref": "#/$defs/runCancelResponse"
    },
    {
      "$ref": "#/$defs/runCompleteResponse"
    },
    {
      "$ref": "#/$defs/contextQueryResponse"
    },
    {
      "$ref": "#/$defs/toolResponse"
    },
    {
      "$ref": "#/$defs/specialistResponse"
    },
    {
      "$ref": "#/$defs/shutdownResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:core|agent):[A-Za-z0-9._:-]+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": true
    },
    "emptyParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "initializeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "initialize"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocolVersions",
            "capabilities",
            "connectionBindingDigest"
          ],
          "properties": {
            "protocolVersions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^2(?:\\.[0-9]+)?$"
              }
            },
            "capabilities": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "connectionBindingDigest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "initializedNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "initialized"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connectionId"
          ],
          "properties": {
            "connectionId": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "runStartRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "agent.run.start"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "taskId",
            "contextPackageRef",
            "idempotencyKey"
          ],
          "properties": {
            "runId": {
              "$ref": "#/$defs/identifier"
            },
            "taskId": {
              "$ref": "#/$defs/identifier"
            },
            "contextPackageRef": {
              "$ref": "#/$defs/identifier"
            },
            "idempotencyKey": {
              "$ref": "#/$defs/identifier"
            },
            "role": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "runCancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "agent.run.cancel"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "reason"
          ],
          "properties": {
            "runId": {
              "$ref": "#/$defs/identifier"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "agentMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId",
        "type",
        "content",
        "claims"
      ],
      "properties": {
        "messageId": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "analysis",
            "proposal",
            "critique",
            "question",
            "answer",
            "support",
            "objection",
            "evidence_request",
            "evidence",
            "decision_recommendation",
            "plan",
            "implementation_report",
            "review",
            "status"
          ]
        },
        "replyTo": {
          "$ref": "#/$defs/identifier"
        },
        "threadId": {
          "$ref": "#/$defs/identifier"
        },
        "content": {
          "type": "string",
          "maxLength": 1048576
        },
        "claims": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement",
              "observationClass"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "observationClass": {
                "enum": [
                  "agent_claimed",
                  "provider_reported",
                  "tool_verified",
                  "core_observed"
                ]
              },
              "evidenceRefs": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        }
      }
    },
    "runCompleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "agent.run.complete"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "status",
            "message"
          ],
          "properties": {
            "runId": {
              "$ref": "#/$defs/identifier"
            },
            "status": {
              "enum": [
                "succeeded",
                "failed",
                "cancelled_cleanly"
              ]
            },
            "message": {
              "$ref": "#/$defs/agentMessage"
            },
            "usage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "inputTokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "outputTokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "providerReportedCostMicrounits": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "streamDeltaNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "agent.stream.delta"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "sequence",
            "channel",
            "delta"
          ],
          "properties": {
            "runId": {
              "$ref": "#/$defs/identifier"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "channel": {
              "enum": [
                "content",
                "status",
                "telemetry"
              ]
            },
            "delta": {
              "type": "string",
              "maxLength": 1048576
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "contextQueryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "context.query"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "queryId",
            "query",
            "scopes",
            "maxItems",
            "maxTokens"
          ],
          "properties": {
            "runId": {
              "$ref": "#/$defs/identifier"
            },
            "queryId": {
              "$ref": "#/$defs/identifier"
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "scopes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "task",
                  "discussion",
                  "project-memory",
                  "decisions",
                  "repository",
                  "artifacts",
                  "tool-results"
                ]
              }
            },
            "maxItems": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "maxTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "toolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "tool.request"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "requestId",
            "tool",
            "arguments",
            "argumentsDigest",
            "reason"
          ],
          "properties": {
            "runId": {
              "$ref": "#/$defs/identifier"
            },
            "requestId": {
              "$ref": "#/$defs/identifier"
            },
            "planStepId": {
              "$ref": "#/$defs/identifier"
            },
            "executorFencingToken": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "tool": {
              "$ref": "#/$defs/identifier"
            },
            "arguments": {
              "type": "object",
              "maxProperties": 256
            },
            "argumentsDigest": {
              "$ref": "#/$defs/sha256"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "specialistRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "specialist.request"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "requestId",
            "capability",
            "reason",
            "requiredContext"
          ],
          "properties": {
            "runId": {
              "$ref": "#/$defs/identifier"
            },
            "requestId": {
              "$ref": "#/$defs/identifier"
            },
            "capability": {
              "$ref": "#/$defs/identifier"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "requiredContext": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "heartbeatNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "agent.heartbeat"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connectionId",
            "sequence"
          ],
          "properties": {
            "connectionId": {
              "$ref": "#/$defs/identifier"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "shutdownRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "shutdown"
        },
        "params": {
          "$ref": "#/$defs/emptyParams"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "exitNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "exit"
        },
        "params": {
          "$ref": "#/$defs/emptyParams"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "initializeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocolVersion",
            "capabilities",
            "connectionId",
            "limits"
          ],
          "properties": {
            "protocolVersion": {
              "type": "string",
              "pattern": "^2(?:\\.[0-9]+)?$"
            },
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "connectionId": {
              "$ref": "#/$defs/identifier"
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maxFrameBytes",
                "maxPendingRequests",
                "streamHighWatermark",
                "streamLowWatermark"
              ],
              "properties": {
                "maxFrameBytes": {
                  "type": "integer",
                  "minimum": 1024
                },
                "maxPendingRequests": {
                  "type": "integer",
                  "minimum": 1
                },
                "streamHighWatermark": {
                  "type": "integer",
                  "minimum": 1
                },
                "streamLowWatermark": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "runStartResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "accepted"
          ],
          "properties": {
            "runId": {
              "$ref": "#/$defs/identifier"
            },
            "accepted": {
              "const": true
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "runCancelResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "outcome"
          ],
          "properties": {
            "runId": {
              "$ref": "#/$defs/identifier"
            },
            "outcome": {
              "enum": [
                "cancellation_requested",
                "already_terminal"
              ]
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "runCompleteResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "recorded",
            "terminalStatus"
          ],
          "properties": {
            "runId": {
              "$ref": "#/$defs/identifier"
            },
            "recorded": {
              "const": true
            },
            "terminalStatus": {
              "enum": [
                "succeeded",
                "failed",
                "cancelled_cleanly"
              ]
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "contextQueryResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queryId",
            "items",
            "truncated",
            "effectivePayloadDigest",
            "redactionReportDigest"
          ],
          "properties": {
            "queryId": {
              "$ref": "#/$defs/identifier"
            },
            "items": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "itemId",
                  "contentRef",
                  "contentDigest",
                  "sourceRefs",
                  "observationClass"
                ],
                "properties": {
                  "itemId": {
                    "$ref": "#/$defs/identifier"
                  },
                  "contentRef": {
                    "$ref": "#/$defs/identifier"
                  },
                  "contentDigest": {
                    "$ref": "#/$defs/sha256"
                  },
                  "sourceRefs": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 128,
                    "items": {
                      "$ref": "#/$defs/identifier"
                    }
                  },
                  "observationClass": {
                    "enum": [
                      "core_observed",
                      "tool_verified",
                      "provider_reported",
                      "agent_claimed",
                      "user_asserted"
                    ]
                  }
                }
              }
            },
            "truncated": {
              "type": "boolean"
            },
            "effectivePayloadDigest": {
              "$ref": "#/$defs/sha256"
            },
            "redactionReportDigest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "toolResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "decision",
            "operationIntentId",
            "status"
          ],
          "properties": {
            "requestId": {
              "$ref": "#/$defs/identifier"
            },
            "decision": {
              "enum": [
                "allowed",
                "denied",
                "approval_required"
              ]
            },
            "operationIntentId": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "status": {
              "enum": [
                "pending",
                "running",
                "succeeded",
                "failed",
                "indeterminate",
                "denied"
              ]
            }
