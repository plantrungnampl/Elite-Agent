{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-terminal.local/schemas/orchestration-benchmark-case-result.v1.schema.json",
  "title": "Orchestration Benchmark Case Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultId",
    "runId",
    "caseId",
    "arm",
    "repeatIndex",
    "metrics",
    "evaluatorVerdict",
    "evidenceRefs",
    "resultDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "resultId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "enum": [
        "single_direct",
        "single_with_retrieval_and_verification",
        "same_model_multi_sample",
        "quick_profile",
        "standard_cross_review",
        "high_assurance",
        "heterogeneous_models"
      ]
    },
    "repeatIndex": {
      "type": "integer",
      "minimum": 1
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_outcome",
        "defect_escape_count",
        "first_pass_test_success",
        "unsupported_claim_count",
        "requirement_omission_count",
        "human_correction_minutes",
        "time_to_accepted_ms",
        "input_tokens",
        "output_tokens",
        "tool_calls",
        "cost_microunits",
        "approval_interruptions",
        "task_abandoned",
        "reviewer_unique_findings"
      ],
      "properties": {
        "accepted_outcome": {
          "type": "boolean"
        },
        "defect_escape_count": {
          "type": "integer",
          "minimum": 0
        },
        "first_pass_test_success": {
          "type": "boolean"
        },
        "unsupported_claim_count": {
          "type": "integer",
          "minimum": 0
        },
        "requirement_omission_count": {
          "type": "integer",
          "minimum": 0
        },
        "human_correction_minutes": {
          "type": "number",
          "minimum": 0
        },
        "time_to_accepted_ms": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "cost_microunits": {
          "type": "integer",
          "minimum": 0
        },
        "approval_interruptions": {
          "type": "integer",
          "minimum": 0
        },
        "task_abandoned": {
          "type": "boolean"
        },
        "reviewer_unique_findings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evaluatorVerdict": {
      "enum": [
        "accepted",
        "rejected",
        "invalid"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resultDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
