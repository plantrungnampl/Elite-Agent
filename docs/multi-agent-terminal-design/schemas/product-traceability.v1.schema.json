{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-terminal.local/schemas/product-traceability.v1.schema.json",
  "title": "Product Traceability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baselineVersion",
    "requirements",
    "generatedAt",
    "traceabilityDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "baselineVersion": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+$"
    },
    "requirements": {
      "type": "array",
      "minItems": 51,
      "uniqueItems": false,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementId",
          "title",
          "designAnchors",
          "machineContracts",
          "validationAnchors",
          "releaseGates",
          "milestones",
          "proofStatus",
          "proofBoundary"
        ],
        "properties": {
          "requirementId": {
            "type": "string",
            "pattern": "^(FR|NFR)-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "designAnchors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "machineContracts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validationAnchors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "releaseGates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "milestones": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proofStatus": {
            "enum": [
              "contract_proven",
              "partially_proven",
              "runtime_unproven",
              "product_unproven"
            ]
          },
          "proofBoundary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "traceabilityDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
