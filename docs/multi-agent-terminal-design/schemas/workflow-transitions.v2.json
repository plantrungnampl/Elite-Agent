{
  "schemaVersion": 2,
  "stateShape": {
    "phase": "PhaseV2",
    "condition": "Condition",
    "operation": "OperationState",
    "workflowProfile": "WorkflowProfile",
    "outcomeMode": "TaskOutcomeMode",
    "streamVersion": "u64",
    "workspaceVersion": "u64",
    "fencingEpoch": "u64"
  },
  "workflowProfiles": [
    "Quick",
    "Standard",
    "HighAssurance",
    "ReadOnlyResearch"
  ],
  "taskOutcomeModes": [
    "ReadOnlyDeliverable",
    "WorkspaceChange",
    "LocalCommit"
  ],
  "trustedProfileSelection": {
    "selectedBy": "trusted_core",
    "inputs": [
      "risk",
      "scope",
      "policy",
      "user_override"
    ],
    "agentSelectionForbidden": true
  },
  "phases": [
    "Intake",
    "ContextBuild",
    "ParallelAnalysis",
    "CrossReview",
    "PrePlanVerification",
    "Synthesis",
    "FinalObjection",
    "AwaitingPlanApproval",
    "Implementation",
    "Verification",
    "Repair",
    "FinalReview",
    "AwaitingDeliverableApproval",
    "AwaitingWorkspaceApproval",
    "AwaitingCommitApproval",
    "RefPromotion",
    "WorkspaceDirty",
    "Completed",
    "Cancelled",
    "Failed"
  ],
  "terminalPhases": [
    "Completed",
    "Cancelled",
    "Failed"
  ],
  "conditions": [
    "Active",
    "Paused",
    "Blocked",
    "BudgetExhausted"
  ],
  "operationStates": [
    "None",
    "AwaitingApproval",
    "Running",
    "Cancelling",
    "Indeterminate"
  ],
  "phaseTransitions": [
    {
      "from": "Intake",
      "event": "task.validated",
      "to": "ContextBuild",
      "guard": "trusted_core_selected_profile_outcome_policy_budgets_valid",
      "effects": [
        "persist_risk",
        "persist_base_identity",
        "persist_workflow_profile",
        "persist_outcome_mode"
      ]
    },
    {
      "from": "ContextBuild",
      "event": "context.initial.ready",
      "to": "ParallelAnalysis",
      "guard": "workflow_profile_in(Standard,HighAssurance,ReadOnlyResearch) AND required_context_packages_valid",
      "effects": [
        "freeze_independent_inputs"
      ]
    },
    {
      "from": "ContextBuild",
      "event": "context.initial.ready",
      "to": "PrePlanVerification",
      "guard": "workflow_profile=Quick AND required_context_packages_valid",
      "effects": [
        "freeze_quick_path_input"
      ]
    },
    {
      "from": "ParallelAnalysis",
      "event": "analysis.quorum.reached",
      "to": "CrossReview",
      "guard": "profile_specific_independent_result_requirement_met",
      "effects": [
        "publish_selected_proposals",
        "assign_review_edges"
      ]
    },
    {
      "from": "CrossReview",
      "event": "review.complete",
      "to": "PrePlanVerification",
      "guard": "review_outputs_or_bounded_stop",
      "effects": [
        "freeze_material_claims"
      ]
    },
    {
      "from": "PrePlanVerification",
      "event": "claims.checked",
      "to": "Synthesis",
      "guard": "all_material_claims_classified",
      "effects": [
        "persist_claim_verification_set"
      ]
    },
    {
      "from": "Synthesis",
      "event": "decision.draft.created",
      "to": "FinalObjection",
      "guard": "decision_schema_and_evidence_valid",
      "effects": [
        "publish_immutable_decision_draft"
      ]
    },
    {
      "from": "FinalObjection",
      "event": "objection.severe.accepted",
      "to": "CrossReview",
      "guard": "reopen_criteria_satisfied AND workflow_profile<>Quick",
      "effects": [
        "increment_review_round"
      ]
    },
    {
      "from": "FinalObjection",
      "event": "objection.severe.accepted",
      "to": "PrePlanVerification",
      "guard": "reopen_criteria_satisfied AND workflow_profile=Quick",
      "effects": [
        "increment_review_round"
      ]
    },
    {
      "from": "FinalObjection",
      "event": "deliverable.review.ready",
      "to": "AwaitingDeliverableApproval",
      "guard": "outcome_mode=ReadOnlyDeliverable AND no_accepted_severe_objection",
      "effects": [
        "freeze_deliverable_artifact",
        "freeze_evidence_set",
        "create_deliverable_approval_request"
      ]
    },
    {
      "from": "AwaitingDeliverableApproval",
      "event": "deliverable.revision.requested",
      "to": "Synthesis",
      "guard": "user_feedback_present",
      "effects": [
        "supersede_deliverable",
        "invalidate_deliverable_approval"
      ]
    },
    {
      "from": "AwaitingDeliverableApproval",
      "event": "deliverable.approved",
      "to": "Completed",
      "guard": "outcome_mode=ReadOnlyDeliverable AND exact_deliverable_evidence_objections_evaluator_and_user_receipt_bound",
      "effects": [
        "create_read_only_completion_package"
      ]
    },
    {
      "from": "FinalObjection",
      "event": "objection.round.closed",
      "to": "AwaitingPlanApproval",
      "guard": "outcome_mode IN (WorkspaceChange,LocalCommit) AND no_accepted_severe_objection",
      "effects": [
        "create_plan_approval_request"
      ]
    },
    {
      "from": "AwaitingPlanApproval",
      "event": "plan.revision.requested",
      "to": "Synthesis",
      "guard": "user_feedback_present",
      "effects": [
        "supersede_decision_draft"
      ]
    },
    {
      "from": "AwaitingPlanApproval",
      "event": "plan.approved",
      "to": "Implementation",
      "guard": "plan_approval_digest_valid",
      "effects": [
        "persist_approved_plan_version",
        "allocate_executor_lease"
      ]
    },
    {
      "from": "Implementation",
      "event": "candidate.prepared",
      "to": "Verification",
      "guard": "no_in_flight_writes AND outcome_mode IN (WorkspaceChange,LocalCommit)",
      "effects": [
        "revoke_executor_lease",
        "reconcile_workspace",
        "create_candidate_tree",
        "create_complete_candidate_commit",
        "persist_candidate_tree_oid",
        "persist_candidate_commit_oid"
      ]
    },
    {
      "from": "Verification",
      "event": "verification.failed",
      "to": "Repair",
      "guard": "repair_budget_available",
      "effects": [
        "discard_candidate_tree",
        "discard_candidate_commit",
        "persist_failure_evidence",
        "allocate_new_executor_token"
      ]
    },
    {
      "from": "Verification",
      "event": "verification.passed",
      "to": "FinalReview",
      "guard": "required_suite_complete AND verification_cites_candidate_tree_oid_and_candidate_commit_oid",
      "effects": [
        "freeze_verified_candidate_evidence",
        "persist_final_commit_verification_receipt"
      ]
    },
    {
      "from": "Repair",
      "event": "candidate.prepared",
      "to": "Verification",
      "guard": "current_fenced_executor_and_scoped_writes",
      "effects": [
        "increment_workspace_version",
        "revoke_executor_lease",
        "create_candidate_tree",
        "create_complete_candidate_commit",
        "persist_candidate_tree_oid",
        "persist_candidate_commit_oid"
      ]
    },
    {
      "from": "FinalReview",
      "event": "review.changes.required",
      "to": "Repair",
      "guard": "review_finding_accepted",
      "effects": [
        "discard_candidate_tree",
        "discard_candidate_commit",
        "invalidate_candidate_verification_receipt",
        "allocate_new_executor_token"
      ]
    },
    {
      "from": "FinalReview",
      "event": "review.accepted",
      "to": "AwaitingWorkspaceApproval",
      "guard": "outcome_mode=WorkspaceChange AND review_cites_candidate_tree_oid_and_candidate_commit_oid",
      "effects": [
        "create_workspace_approval_request"
      ]
    },
    {
      "from": "AwaitingWorkspaceApproval",
      "event": "workspace.repair.requested",
      "to": "Repair",
      "guard": "user_feedback_present",
      "effects": [
        "discard_candidate_tree",
        "discard_candidate_commit",
        "invalidate_workspace_approval",
        "allocate_new_executor_token"
      ]
    },
    {
      "from": "AwaitingWorkspaceApproval",
      "event": "workspace.approved",
      "to": "Completed",
      "guard": "outcome_mode=WorkspaceChange AND approval_binds_verified_workspace_candidate",
      "effects": [
        "create_workspace_completion_package"
      ]
    },
    {
      "from": "FinalReview",
      "event": "review.accepted",
      "to": "AwaitingCommitApproval",
      "guard": "outcome_mode=LocalCommit AND review_cites_candidate_tree_oid_and_candidate_commit_oid",
      "effects": [
        "create_final_commit_approval_request"
      ]
    },
    {
      "from": "AwaitingCommitApproval",
      "event": "commit.repair.requested",
      "to": "Repair",
      "guard": "user_feedback_present",
      "effects": [
        "discard_candidate_tree",
        "discard_candidate_commit",
        "invalidate_candidate_and_approval",
        "allocate_new_executor_token"
      ]
    },
    {
      "from": "AwaitingCommitApproval",
      "event": "commit.approved",
      "to": "RefPromotion",
      "guard": "outcome_mode=LocalCommit AND approval_binds_candidate_commit_oid_and_expected_old_oid",
      "effects": [
        "persist_final_commit_approval"
      ]
    },
    {
      "from": "RefPromotion",
      "event": "ref.cas.succeeded",
      "to": "Completed",
      "guard": "ref_now_equals_candidate_commit_oid AND expected_old_value_cas_succeeded",
      "effects": [
        "persist_ref_promotion_receipt",
        "create_local_commit_completion_package"
      ]
    },
    {
      "from": "RefPromotion",
      "event": "ref.cas.failed",
      "to": "WorkspaceDirty",
      "guard": "ref_or_workspace_diverged",
      "effects": [
        "preserve_candidate_commit",
        "invalidate_final_commit_approval",
        "capture_workspace_evidence"
      ]
    },
    {
      "from": "WorkspaceDirty",
      "event": "workspace.repair.authorized",
      "to": "Repair",
      "guard": "mutation_evidence_preserved",
      "effects": [
        "discard_candidate_tree",
        "discard_candidate_commit",
        "allocate_new_executor_token"
      ]
    },
    {
      "from": "WorkspaceDirty",
      "event": "workspace.reconciled",
      "to": "FinalReview",
      "guard": "candidate_commit_rebuilt_and_verified",
      "effects": [
        "create_candidate_tree",
        "create_complete_candidate_commit",
        "persist_final_commit_verification_receipt"
      ]
    }
  ],
  "workspaceDirtySources": [
    "Implementation",
    "Verification",
    "Repair",
    "FinalReview",
    "AwaitingWorkspaceApproval",
    "AwaitingCommitApproval",
    "RefPromotion"
  ],
  "workspaceDirtyTransition": {
    "event": "workspace.mutated",
    "to": "WorkspaceDirty",
    "effects": [
      "revoke_executor_lease",
      "increment_fencing_epoch",
      "invalidate_affected_approvals",
      "discard_candidate_tree",
      "discard_candidate_commit",
      "stop_write_capable_tools",
      "capture_workspace_evidence"
    ]
  },
  "conditionTransitions": [
    {
      "from": "Active",
      "event": "task.paused",
      "to": "Paused",
      "guard": "phase_nonterminal"
    },
    {
      "from": "Paused",
      "event": "task.resumed",
      "to": "Active",
      "guard": "policy_budget_workspace_and_lease_valid"
    },
    {
      "from": "Active",
      "event": "task.blocked",
      "to": "Blocked",
      "guard": "blocking_reason_persisted"
    },
    {
      "from": "Blocked",
      "event": "task.unblocked",
      "to": "Active",
      "guard": "blocking_condition_cleared"
    },
    {
      "from": "Active",
      "event": "budget.exhausted",
      "to": "BudgetExhausted",
      "guard": "budget_authority_confirmed"
    },
    {
      "from": "BudgetExhausted",
      "event": "budget.extended",
      "to": "Active",
      "guard": "trusted_budget_extension_receipt"
    }
  ]
}
