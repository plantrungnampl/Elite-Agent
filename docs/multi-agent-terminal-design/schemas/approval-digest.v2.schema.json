{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-terminal.local/schemas/approval-digest.v2.schema.json",
  "title": "Approval Digest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "approvalType",
    "taskId",
    "operationIntentId",
    "actorBindingDigest",
    "operation",
    "policySnapshotDigest",
    "workspaceVersion",
    "requestedAt",
    "expiresAt",
    "nonce"
  ],
  "properties": {
    "schema": {
      "const": "approval-digest.v2"
    },
    "approvalType": {
      "enum": [
        "plan",
        "tool",
        "policy_exception",
        "final_commit"
      ]
    },
    "taskId": {
      "$ref": "#/$defs/identifier"
    },
    "operationIntentId": {
      "$ref": "#/$defs/identifier"
    },
    "actorBindingDigest": {
      "$ref": "#/$defs/sha256"
    },
    "operation": {
      "type": "object"
    },
    "policySnapshotDigest": {
      "$ref": "#/$defs/sha256"
    },
    "workspaceVersion": {
      "type": "integer",
      "minimum": 0
    },
    "requestedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "#/$defs/timestamp"
    },
    "nonce": {
      "type": "string",
      "minLength": 32,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approvalType": {
            "const": "plan"
          }
        },
        "required": [
          "approvalType"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "$ref": "#/$defs/planOperation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approvalType": {
            "const": "tool"
          }
        },
        "required": [
          "approvalType"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "$ref": "#/$defs/toolOperation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approvalType": {
            "const": "policy_exception"
          }
        },
        "required": [
          "approvalType"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "$ref": "#/$defs/policyExceptionOperation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approvalType": {
            "const": "final_commit"
          }
        },
        "required": [
          "approvalType"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "$ref": "#/$defs/finalCommitOperation"
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": true
    },
    "planRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "contentDigest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "pathScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootCapability",
        "patterns"
      ],
      "properties": {
        "rootCapability": {
          "$ref": "#/$defs/identifier"
        },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "planOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "baseCommit",
        "allowedPaths",
        "plannedToolDigests",
        "verificationProfileDigest",
        "riskClass"
      ],
      "properties": {
        "plan": {
          "$ref": "#/$defs/planRef"
        },
        "baseCommit": {
          "$ref": "#/$defs/gitObjectId"
        },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/pathScope"
          }
        },
        "plannedToolDigests": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "verificationProfileDigest": {
          "$ref": "#/$defs/sha256"
        },
        "riskClass": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "toolOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "planStepId",
        "tool",
        "argumentsDigest",
        "cwdCapability",
        "environmentProfileDigest",
        "networkProfile",
        "expectedWrites",
        "executorFencingToken"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/identifier"
        },
        "planStepId": {
          "$ref": "#/$defs/identifier"
        },
        "tool": {
          "$ref": "#/$defs/identifier"
        },
        "executableDigest": {
          "$ref": "#/$defs/sha256"
        },
        "argumentsDigest": {
          "$ref": "#/$defs/sha256"
        },
        "scriptDigest": {
          "$ref": "#/$defs/sha256"
        },
        "cwdCapability": {
          "$ref": "#/$defs/identifier"
        },
        "environmentProfileDigest": {
          "$ref": "#/$defs/sha256"
        },
        "networkProfile": {
          "enum": [
            "denied",
            "provider_endpoint_only",
            "approved_destinations"
          ]
        },
        "expectedWrites": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "executorFencingToken": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "policyExceptionOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "resourceDigest",
        "destination",
        "effectivePayloadDigest",
        "redactionReportDigest"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "resourceDigest": {
          "$ref": "#/$defs/sha256"
        },
        "destination": {
          "$ref": "#/$defs/identifier"
        },
        "effectivePayloadDigest": {
          "$ref": "#/$defs/sha256"
        },
        "redactionReportDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "commitMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageDigest",
        "authorIdentityRef",
        "authorTimestamp",
        "committerIdentityRef",
        "committerTimestamp",
        "hookPolicy"
      ],
      "properties": {
        "messageDigest": {
          "$ref": "#/$defs/sha256"
        },
        "authorIdentityRef": {
          "$ref": "#/$defs/identifier"
        },
        "authorTimestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "committerIdentityRef": {
          "$ref": "#/$defs/identifier"
        },
        "committerTimestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "hookPolicy": {
          "enum": [
            "disabled_exact_object",
            "preverified_hooks"
          ]
        },
        "signatureDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "finalCommitOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryIdentityDigest",
        "baseCommit",
        "expectedRef",
        "expectedOldRefValue",
        "candidateTree",
        "candidateCommitOid",
        "plan",
        "verificationSetDigest",
        "reviewArtifactDigest",
        "commit",
        "executorFencingEpoch"
      ],
      "properties": {
        "repositoryIdentityDigest": {
          "$ref": "#/$defs/sha256"
        },
        "baseCommit": {
          "$ref": "#/$defs/gitObjectId"
        },
        "expectedRef": {
          "type": "string",
          "pattern": "^refs/heads/[A-Za-z0-9._/-]+$",
          "maxLength": 1024
        },
        "expectedOldRefValue": {
          "$ref": "#/$defs/gitObjectId"
        },
        "candidateTree": {
          "$ref": "#/$defs/gitObjectId"
        },
        "candidateCommitOid": {
          "$ref": "#/$defs/gitObjectId"
        },
        "plan": {
          "$ref": "#/$defs/planRef"
        },
        "verificationSetDigest": {
          "$ref": "#/$defs/sha256"
        },
        "reviewArtifactDigest": {
          "$ref": "#/$defs/sha256"
        },
        "commit": {
          "$ref": "#/$defs/commitMetadata"
        },
        "executorFencingEpoch": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
