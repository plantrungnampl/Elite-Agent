{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-terminal.local/schemas/cognitive-memory.v1.schema.json",
  "title": "Cognitive Memory Extension v1",
  "$defs": {
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceRevision",
        "contentHash",
        "sourceKind"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceKind": {
          "enum": [
            "artifact",
            "source-document",
            "source-chunk",
            "memory",
            "event",
            "tool-receipt",
            "decision"
          ]
        },
        "locator": {
          "type": "object"
        }
      }
    },
    "retrievalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "projectId",
        "taskId",
        "runId",
        "objective",
        "role",
        "scopes",
        "methods",
        "maxItems",
        "maxTokens",
        "policySnapshotDigest"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "taskClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "exact",
              "keyword",
              "vector",
              "graph",
              "episodic",
              "semantic",
              "procedural",
              "negative",
              "preference",
              "temporal"
            ]
          }
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictionTargets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 128
        },
        "policySnapshotDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "retrievalCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "source",
        "rank",
        "scoreMillionths",
        "methods",
        "reason",
        "freshness"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "scoreMillionths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        },
        "contradictionOf": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "sensitivity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "retrievalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "requestId",
        "engineId",
        "engineVersion",
        "pipelineVersion",
        "status",
        "branches",
        "candidates",
        "traceDigest"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "engineId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "engineVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pipelineVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": [
            "succeeded",
            "degraded",
            "failed"
          ]
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "status"
            ],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "status": {
                "enum": [
                  "used",
                  "degraded",
                  "denied",
                  "unavailable",
                  "not-requested"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/retrievalCandidate"
          }
        },
        "traceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "memoryProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalId",
        "projectId",
        "originTaskId",
        "originRunId",
        "memoryType",
        "contentArtifactId",
        "applicability",
        "evidence",
        "confidenceMillionths",
        "invalidationConditions",
        "sensitivity"
      ],
      "properties": {
        "proposalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "originTaskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "originRunId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "memoryType": {
          "enum": [
            "episodic",
            "semantic",
            "procedural",
            "negative",
            "preference"
          ]
        },
        "contentArtifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "scope"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "$ref": "#/$defs/memoryScope"
            },
            "systems": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "taskClasses": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "repositoryRevisionConstraints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "confidenceMillionths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "invalidationConditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "sensitivity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "user",
                "project",
                "workspace"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "memoryType": {
                "const": "preference"
              }
            },
            "required": [
              "memoryType"
            ]
          },
          "then": {
            "required": [
              "subject"
            ]
          }
        }
      ]
    },
    "contextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "category",
        "source",
        "inclusionReason",
        "authorityState"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "enum": [
            "fact",
            "inference",
            "unknown",
            "decision",
            "objection",
            "contradiction",
            "repository-evidence",
            "episode",
            "knowledge",
            "procedure",
            "negative-memory",
            "preference",
            "required-check"
          ]
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        },
        "inclusionReason": {
          "type": "string",
          "minLength": 1
        },
        "authorityState": {
          "enum": [
            "authoritative",
            "verified-memory",
            "assertion",
            "unknown"
          ]
        },
        "tokenCount": {
          "type": "integer",
          "minimum": 0
        },
        "redacted": {
          "type": "boolean"
        }
      }
    },
    "contextPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "schemaVersion",
        "projectId",
        "taskId",
        "runId",
        "agentId",
        "role",
        "objective",
        "createdAt",
        "retrievalSessionId",
        "items",
        "policyDecisionIds",
        "policySnapshotDigest",
        "retrievalPipelineVersion",
        "contextCompilerVersion",
        "contentHash",
        "successCriteria",
        "budget",
        "taskState",
        "workingMemory",
        "requiredChecks",
        "permissions",
        "provenance",
        "redactions",
        "promptTemplateVersion"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "schemaVersion": {
          "const": "cognitive-context.v1"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "retrievalSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextItem"
          },
          "minItems": 0
        },
        "policyDecisionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        },
        "policySnapshotDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "retrievalPipelineVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contextCompilerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 of the exact effective model-input artifact, not a self-hash of this manifest."
        },
        "successCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budget": {
          "$ref": "#/$defs/contextBudget"
        },
        "taskState": {
          "$ref": "#/$defs/taskState"
        },
        "workingMemory": {
          "$ref": "#/$defs/workingMemoryState"
        },
        "requiredChecks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "permissions": {
          "$ref": "#/$defs/permissionEnvelope"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "redactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/redactionReceipt"
          }
        },
        "promptTemplateVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "description": "Immutable context manifest for one preallocated agent run. The effective model-input bytes are stored as a separate content-addressed artifact."
    },
    "contextFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feedbackId",
        "runId",
        "packageId",
        "items"
      ],
      "properties": {
        "feedbackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "packageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "itemId",
              "label",
              "usedInConclusion"
            ],
            "properties": {
              "itemId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "label": {
                "enum": [
                  "critical",
                  "useful",
                  "redundant",
                  "irrelevant",
                  "stale",
                  "contradictory",
                  "misleading"
                ]
              },
              "usedInConclusion": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "runEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluationId",
        "projectId",
        "taskId",
        "runId",
        "evaluatorVersion",
        "configurationDigest",
        "scores",
        "gateDecision",
        "evidence",
        "evaluatorKind"
      ],
      "properties": {
        "evaluationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "evaluatorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "configurationDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "scores": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "correctness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "evidenceGrounding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "requirementCoverage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "constraintAdherence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "completeness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "efficiency": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "toolUseQuality": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "uncertaintyCalibration": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "regressionRisk": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "preferenceAdherence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        },
        "gateDecision": {
          "enum": [
            "pass",
            "repair",
            "blocked",
            "indeterminate"
          ]
        },
        "missedRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupportedClaims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "evaluatorKind": {
          "enum": [
            "deterministic",
            "model",
            "human",
            "ensemble"
          ]
        }
      }
    },
    "contextSupplementRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "runId",
        "parentPackageId",
        "kind",
        "reason",
        "maxItems",
        "maxTokens"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "parentPackageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "more",
            "source",
            "related-symbols",
            "previous-failures",
            "decision-history"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 128
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "source"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "sourceId"
            ]
          }
        }
      ]
    },
    "contextSupplement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplementId",
        "parentPackageId",
        "runId",
        "items",
        "policyDecisionIds",
        "remainingSupplementTokens",
        "contentHash"
      ],
      "properties": {
        "supplementId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "parentPackageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextItem"
          }
        },
        "policyDecisionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "remainingSupplementTokens": {
          "type": "integer",
          "minimum": 0
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 of the exact effective supplement bytes, not a self-hash of this manifest."
        }
      },
      "description": "Immutable supplement manifest bound to one parent package and run."
    },
    "workingMemoryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "runId",
        "sequence",
        "eventType",
        "statement"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "eventType": {
          "enum": [
            "fact.recorded",
            "inference.recorded",
            "unknown.recorded",
            "hypothesis.opened",
            "hypothesis.supported",
            "hypothesis.refuted",
            "next_action.changed",
            "check.required",
            "check.completed"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "supportingFactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "confidenceMillionths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eventType": {
                "enum": [
                  "fact.recorded",
                  "check.completed"
                ]
              }
            },
            "required": [
              "eventType"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/sourceReference"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "enum": [
                  "inference.recorded",
                  "hypothesis.opened",
                  "hypothesis.supported",
                  "hypothesis.refuted"
                ]
              }
            },
            "required": [
              "eventType"
            ]
          },
          "then": {
            "required": [
              "supportingFactIds",
              "confidenceMillionths"
            ],
            "properties": {
              "supportingFactIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          }
        }
      ]
    },
