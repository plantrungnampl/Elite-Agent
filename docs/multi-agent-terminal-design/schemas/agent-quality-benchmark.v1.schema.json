{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-terminal.local/schemas/agent-quality-benchmark.v1.schema.json",
  "title": "Agent Quality Benchmark Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suiteId",
    "version",
    "name",
    "createdAt",
    "cases"
  ],
  "properties": {
    "suiteId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "taskClass",
          "objective",
          "repositoryRevision",
          "budgetProfile",
          "requiredFacts",
          "requiredEvidence",
          "forbiddenMistakes",
          "acceptanceRules"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "taskClass": {
            "enum": [
              "bug-diagnosis",
              "code-modification",
              "architecture-design",
              "security-review",
              "repository-onboarding",
              "migration-planning",
              "regression-investigation",
              "research"
            ]
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "repositoryRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "fixtureArtifactIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "budgetProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "maxTokens",
              "maxToolCalls",
              "maxDurationMs"
            ],
            "properties": {
              "maxTokens": {
                "type": "integer",
                "minimum": 1
              },
              "maxToolCalls": {
                "type": "integer",
                "minimum": 0
              },
              "maxDurationMs": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "requiredFacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiredEvidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbiddenMistakes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiredChecks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptanceRules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
