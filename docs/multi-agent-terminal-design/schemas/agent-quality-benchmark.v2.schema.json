{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-terminal.local/schemas/agent-quality-benchmark.v2.schema.json",
  "title": "Agent Quality Controlled Benchmark Suite v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["suiteId", "version", "name", "createdAt", "experimentArms", "comparisonRules", "cases"],
  "properties": {
    "suiteId": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"type": "integer", "minimum": 2},
    "name": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "description": {"type": "string"},
    "experimentArms": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["control_no_memory", "compaction_only", "evidence_retrieval", "evidence_plus_experience"]},
      "allOf": [
        {"contains": {"const": "control_no_memory"}},
        {"contains": {"const": "compaction_only"}},
        {"contains": {"const": "evidence_retrieval"}},
        {"contains": {"const": "evidence_plus_experience"}}
      ]
    },
    "comparisonRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equalModelConfiguration", "equalEvaluatorConfiguration", "equalRepositoryRevision", "equalBudgetProfile", "reportPerCaseRegressions"],
      "properties": {
        "equalModelConfiguration": {"const": true},
        "equalEvaluatorConfiguration": {"const": true},
        "equalRepositoryRevision": {"const": true},
        "equalBudgetProfile": {"const": true},
        "reportPerCaseRegressions": {"const": true}
      }
    },
    "primaryMetrics": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["first_pass_verifier_acceptance", "repeated_known_error_rate", "unsupported_claim_rate", "stale_memory_use_rate", "cross_scope_leakage", "token_cost", "latency_ms", "memory_contribution"]}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "taskClass", "objective", "repositoryRevision", "fixturePaths", "budgetProfile", "expectedInformationNeeds", "requiredFacts", "requiredEvidence", "forbiddenMistakes", "acceptanceRules"],
        "properties": {
          "caseId": {"type": "string", "minLength": 1, "maxLength": 200},
          "taskClass": {"enum": ["bug-diagnosis", "code-modification", "architecture-design", "security-review", "repository-onboarding", "migration-planning", "regression-investigation", "research"]},
          "objective": {"type": "string", "minLength": 1},
          "repositoryRevision": {"type": "string", "minLength": 1, "maxLength": 200},
          "fixturePaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "applicableMemoryFixtureIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
          "budgetProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxTokens", "maxToolCalls", "maxDurationMs"],
            "properties": {
              "maxTokens": {"type": "integer", "minimum": 1},
              "maxToolCalls": {"type": "integer", "minimum": 0},
              "maxDurationMs": {"type": "integer", "minimum": 1}
            }
          },
          "expectedInformationNeeds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "requiredFacts": {"type": "array", "items": {"type": "string"}},
          "requiredEvidence": {"type": "array", "items": {"type": "string"}},
          "forbiddenMistakes": {"type": "array", "items": {"type": "string"}},
          "requiredChecks": {"type": "array", "items": {"type": "string"}},
          "acceptanceRules": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
